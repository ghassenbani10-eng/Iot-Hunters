<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tunibot_gazebo_plugins</name>
  <version>0.2.0</version>
  <description>Gazebo Classic plugins for the TuniBot simulation: walking humans visible to the lidar (actor + collision proxy, yields to the robot).</description>
  <maintainer email="ghassen.bani@supcom.tn">Ghassen Bani</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
